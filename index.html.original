<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Seedarr - BitTorrent Seeding Simulator</title>
  <meta name="description" content="Seedarr is a BitTorrent seeding simulator built on the *arr architecture. Maintain your ratio, keep torrents alive, and integrate with Sonarr and Radarr.">

  <!-- Favicon -->
  <link rel="icon" href="img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="img/favicon.svg">

  <!-- Open Graph -->
  <meta property="og:type"         content="website">
  <meta property="og:url"          content="https://seedarr.net/">
  <meta property="og:title"        content="Seedarr - BitTorrent Seeding Simulator">
  <meta property="og:description"  content="The *arr approach to BitTorrent seeding. Maintain your ratio, keep torrents alive, and auto-seed from Sonarr and Radarr — without transferring actual data.">
  <meta property="og:image"        content="https://seedarr.net/img/og-image.png">
  <meta property="og:image:width"  content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name"    content="Seedarr">

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="Seedarr - BitTorrent Seeding Simulator">
  <meta name="twitter:description" content="The *arr approach to BitTorrent seeding. Maintain your ratio, keep torrents alive, and auto-seed from Sonarr and Radarr — without transferring actual data.">
  <meta name="twitter:image"       content="https://seedarr.net/img/og-image.png">

  <link rel="stylesheet" href="vendor/css/bootstrap.min.css">
  <link rel="stylesheet" href="vendor/css/fontawesome.min.css">
  <link rel="stylesheet" href="vendor/css/highlight-github-dark.min.css">

  <style>
    /* ─── Design tokens (matches Seedarr React UI App.css) ─── */
    :root {
      --bg-primary:    #222018;
      --bg-secondary:  #2a2620;
      --bg-dark:       #1a1815;
      --bg-hover:      #3a352e;
      --border:        #3a352e;
      --border-light:  #302c24;
      --text-primary:  #e8dcc8;
      --text-secondary:#b0a48e;
      --text-muted:    #7a7060;
      --text-dim:      #5a5248;
      --accent:        #c8a84e;
      --accent-dark:   #a88a30;
      --accent-bg:     rgba(200,168,78,0.15);
      --accent-subtle: rgba(200,168,78,0.06);
      --accent-border: rgba(200,168,78,0.35);
      --success:       #8a9a3a;
      --success-bg:    rgba(138,154,58,0.2);
      --danger:        #b5443a;
    }

    /* ─── Reset / Base ─── */
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: var(--bg-primary);
      color: var(--text-secondary);
      padding-top: 50px;
    }
    a { color: var(--accent); }
    a:hover { color: var(--accent-dark); }

    /* ─── Navbar ─── */
    .navbar-inverse {
      background: var(--bg-dark);
      border: none;
      border-bottom: 1px solid var(--border-light);
    }
    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 15px;
    }
    .navbar-brand img.brand-icon { width: 28px; height: 28px; flex-shrink: 0; }
    .navbar-brand img.brand-text { height: 20px; flex-shrink: 0; }
    .navbar-inverse .navbar-nav > li > a {
      color: var(--text-muted) !important;
      font-size: 13px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      padding: 15px 14px;
      transition: color 0.2s;
    }
    .navbar-inverse .navbar-nav > li > a:hover,
    .navbar-inverse .navbar-nav > li.active > a {
      color: var(--accent) !important;
      background: transparent !important;
    }
    .navbar-inverse .navbar-nav > li > a i { margin-right: 5px; }
    .navbar-toggle { border-color: var(--border) !important; }
    .navbar-toggle .icon-bar { background: var(--text-muted) !important; }

    /* ─── Hero ─── */
    #hero {
      background: linear-gradient(160deg, var(--bg-dark) 0%, var(--bg-primary) 60%, #1c1a12 100%);
      padding: 90px 0 70px;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid var(--border-light);
    }
    #hero::before {
      content: '';
      position: absolute;
      top: -180px; right: -180px;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(200,168,78,0.07) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-logo {
      width: 130px;
      height: 130px;
      margin: 0 auto 24px;
      display: block;
      animation: logo-pulse 3s ease-in-out infinite;
    }
    @keyframes logo-pulse {
      0%, 100% { transform: scale(1); filter: brightness(1); }
      50% { transform: scale(1.06); filter: brightness(1.15); }
    }
    .hero-wordmark {
      display: block;
      height: 38px;
      margin: 0 auto 14px;
      animation: logo-pulse 3s ease-in-out infinite;
    }
    .hero-tagline {
      font-size: 19px;
      color: var(--text-muted);
      margin: 0 0 36px;
    }
    .hero-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-bottom: 40px;
    }
    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--accent-subtle);
      border: 1px solid var(--accent-border);
      color: var(--accent);
      border-radius: 20px;
      padding: 6px 16px;
      font-size: 13px;
    }
    .hero-cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .btn-seedarr {
      background: var(--accent);
      color: var(--bg-dark);
      border: none;
      border-radius: 3px;
      padding: 12px 28px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.3px;
      transition: background 0.2s, transform 0.1s;
      text-decoration: none;
      display: inline-block;
    }
    .btn-seedarr:hover { background: var(--accent-dark); color: var(--bg-dark); transform: translateY(-1px); text-decoration: none; }
    .btn-seedarr-outline {
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--accent-border);
      border-radius: 3px;
      padding: 12px 28px;
      font-size: 15px;
      transition: background 0.2s, color 0.2s;
      text-decoration: none;
      display: inline-block;
    }
    .btn-seedarr-outline:hover { background: var(--accent-bg); color: var(--accent); text-decoration: none; }

    /* ─── Section shared ─── */
    .section-header { text-align: center; margin-bottom: 60px; }
    .section-header h2 { font-size: 32px; font-weight: 300; color: var(--text-primary); margin-bottom: 12px; }
    .section-header h2 span { color: var(--accent); }
    .section-header p { font-size: 16px; color: var(--text-muted); max-width: 560px; margin: 0 auto; }
    .divider { width: 48px; height: 2px; background: var(--accent); margin: 14px auto 22px; border-radius: 1px; }

    /* ─── Stats bar ─── */
    #stats {
      background: var(--bg-dark);
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
      padding: 36px 0;
    }
    .stats-grid { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 24px; }
    .stat-item { text-align: center; }
    .stat-value { font-size: 34px; font-weight: 200; color: var(--accent); line-height: 1; margin-bottom: 6px; }
    .stat-label { font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1.2px; }

    /* ─── Features ─── */
    #features { padding: 80px 0; background: var(--bg-primary); }
    .feature-row {
      display: flex;
      align-items: center;
      gap: 50px;
      margin-bottom: 80px;
      padding-bottom: 80px;
      border-bottom: 1px solid var(--border-light);
    }
    .feature-row:last-child { margin-bottom: 0; padding-bottom: 0; border: none; }
    .feature-row.reverse { flex-direction: row-reverse; }
    .feature-visual {
      flex: 0 0 48%;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 260px;
      position: relative;
      overflow: hidden;
    }
    .feature-visual::before {
      content: '';
      position: absolute;
      top: -40px; right: -40px;
      width: 200px; height: 200px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(200,168,78,0.05) 0%, transparent 70%);
    }
    .feature-info { flex: 1; }
    .feature-info h3 { font-size: 24px; font-weight: 300; color: var(--text-primary); margin-bottom: 12px; }
    .feature-info h3 i { color: var(--accent); margin-right: 10px; font-size: 18px; }
    .feature-info p { font-size: 15px; color: var(--text-muted); line-height: 1.7; margin-bottom: 18px; }
    .feature-list { list-style: none; padding: 0; margin: 0; }
    .feature-list li { padding: 4px 0; font-size: 14px; color: var(--text-secondary); display: flex; align-items: flex-start; gap: 8px; }
    .feature-list li i { color: var(--accent); margin-top: 3px; flex-shrink: 0; }

    /* Feature grid cards */
    .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 48px; }
    .feature-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 26px 22px;
      transition: border-color 0.2s, transform 0.15s;
    }
    .feature-card:hover { border-color: var(--accent-border); transform: translateY(-2px); }
    .feature-card i { font-size: 26px; color: var(--accent); margin-bottom: 12px; display: block; }
    .feature-card h4 { color: var(--text-primary); font-size: 15px; font-weight: 600; margin-bottom: 7px; }
    .feature-card p { color: var(--text-muted); font-size: 13px; line-height: 1.6; margin: 0; }

    /* ─── Mock dashboard ─── */
    .mock-dashboard { width: 100%; background: var(--bg-dark); border-radius: 5px; border: 1px solid var(--border); overflow: hidden; }
    .mock-titlebar { background: var(--bg-secondary); padding: 8px 12px; display: flex; align-items: center; gap: 5px; }
    .mock-dot { width: 9px; height: 9px; border-radius: 50%; }
    .mock-dot.red    { background: var(--danger); }
    .mock-dot.yellow { background: var(--accent); opacity: 0.7; }
    .mock-dot.green  { background: var(--success); }
    .mock-url { margin-left: 10px; font-size: 11px; color: var(--text-dim); }
    .mock-body { padding: 16px; }
    .mock-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 11px; border-radius: 3px; margin-bottom: 5px; background: var(--bg-secondary); font-size: 12px; }
    .mock-name { color: var(--text-secondary); font-weight: 500; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mock-badge { display: inline-block; padding: 2px 7px; border-radius: 10px; font-size: 10px; font-weight: 700; margin-left: 8px; }
    .mock-badge.seeding { background: var(--success-bg); color: var(--success); }
    .mock-badge.paused  { background: rgba(122,112,96,0.2); color: var(--text-dim); }
    .mock-speed { color: var(--accent); font-size: 11px; margin-left: 8px; }
    .mock-bar { height: 2px; background: var(--border); border-radius: 1px; margin-top: 8px; }
    .mock-bar-fill { height: 100%; background: var(--accent); border-radius: 1px; }

    /* Protocol grid */
    .mock-protocols { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
    .mock-proto { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 4px; padding: 9px 11px; font-size: 11px; }
    .mock-proto-name { color: var(--text-secondary); font-weight: 600; margin-bottom: 2px; }
    .mock-proto-status { color: var(--success); font-size: 10px; }
    .mock-proto-status.warn { color: var(--accent); }

    /* ─── Integration ─── */
    #integration { padding: 80px 0; background: var(--bg-secondary); }
    .integration-cards { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; margin-top: 40px; }
    .int-card { background: var(--bg-primary); border: 1px solid var(--border); border-radius: 6px; padding: 28px 34px; text-align: center; transition: border-color 0.2s; min-width: 170px; }
    .int-card:hover { border-color: var(--accent-border); }
    .int-card i { font-size: 32px; color: var(--accent); margin-bottom: 10px; display: block; }
    .int-card h4 { color: var(--text-primary); font-size: 17px; font-weight: 300; margin-bottom: 5px; }
    .int-card p { color: var(--text-muted); font-size: 12px; margin: 0; }

    /* ─── Download ─── */
    #download { padding: 80px 0; background: var(--bg-primary); }
    .nav-tabs { border-bottom: 1px solid var(--border); margin-bottom: 28px; }
    .nav-tabs > li > a {
      color: var(--text-muted);
      background: transparent;
      border: 1px solid transparent;
      border-radius: 3px 3px 0 0;
      padding: 9px 16px;
      font-size: 13px;
      transition: color 0.2s;
    }
    .nav-tabs > li > a:hover { color: var(--accent); background: var(--accent-subtle); border-color: transparent; }
    .nav-tabs > li.active > a,
    .nav-tabs > li.active > a:focus,
    .nav-tabs > li.active > a:hover {
      background: var(--bg-secondary);
      color: var(--accent);
      border: 1px solid var(--border);
      border-bottom-color: var(--bg-secondary);
    }
    .tab-content { color: var(--text-secondary); }
    .tab-pane h4 { color: var(--text-primary); font-size: 17px; font-weight: 300; margin-bottom: 14px; }
    .tab-pane p { color: var(--text-muted); line-height: 1.7; margin-bottom: 14px; }
    .tab-pane ol, .tab-pane ul { color: var(--text-muted); padding-left: 20px; }
    .tab-pane li { margin-bottom: 7px; line-height: 1.6; }
    pre { background: var(--bg-dark) !important; border: 1px solid var(--border) !important; border-radius: 5px; padding: 18px !important; font-size: 13px; }
    code { background: var(--accent-subtle); color: var(--accent); padding: 2px 5px; border-radius: 3px; font-size: 12px; }
    pre code { background: none; color: #cdd6f4; padding: 0; font-size: 13px; }
    .download-btn {
      display: inline-block;
      background: var(--accent);
      color: var(--bg-dark);
      padding: 9px 20px;
      border-radius: 3px;
      font-weight: 700;
      font-size: 13px;
      margin: 3px;
      transition: background 0.2s;
      text-decoration: none;
    }
    .download-btn:hover { background: var(--accent-dark); color: var(--bg-dark); text-decoration: none; }
    .download-btn i { margin-right: 6px; }
    .download-note {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 18px;
      padding: 13px 16px;
      background: var(--accent-subtle);
      border-left: 3px solid var(--accent);
      border-radius: 0 4px 4px 0;
    }

    /* ─── Footer ─── */
    footer {
      background: var(--bg-dark);
      border-top: 1px solid var(--border-light);
      padding: 48px 0 30px;
    }
    .footer-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .footer-logo img.f-icon { width: 34px; height: 34px; }
    .footer-logo img.f-text { height: 22px; }
    .footer-tagline { color: var(--text-dim); font-size: 13px; margin-bottom: 22px; }
    .footer-links { display: flex; gap: 18px; flex-wrap: wrap; }
    .footer-links a { color: var(--text-dim); font-size: 13px; text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--accent); }
    .footer-copy { margin-top: 36px; padding-top: 22px; border-top: 1px solid var(--border-light); text-align: center; font-size: 12px; color: var(--text-dim); }
    .footer-copy a { color: var(--text-dim); }
    .footer-copy a:hover { color: var(--accent); }
    .arr-family { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
    .arr-link { color: var(--text-dim); font-size: 12px; text-decoration: none; padding: 4px 10px; border: 1px solid var(--border); border-radius: 3px; transition: border-color 0.2s, color 0.2s; }
    .arr-link:hover { border-color: var(--accent-border); color: var(--accent); text-decoration: none; }

    /* ─── Scrollbar ─── */
    * { scrollbar-color: var(--border) var(--bg-primary); scrollbar-width: thin; }
    *::-webkit-scrollbar { width: 8px; height: 8px; }
    *::-webkit-scrollbar-track { background: var(--bg-primary); }
    *::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    *::-webkit-scrollbar-thumb:hover { background: var(--bg-hover); }

    /* ─── Responsive ─── */
    @media (max-width: 767px) {
      .hero-wordmark { height: 28px; }
      .hero-tagline { font-size: 15px; }
      .feature-row, .feature-row.reverse { flex-direction: column !important; gap: 28px; }
      .feature-visual { flex: none; width: 100%; }
    }

    /* ─── Screenshots / Carousel ─── */
    #screenshots {
      padding: 80px 0 60px;
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border-light);
    }
    .seedarr-carousel {
      max-width: 800px;
      margin: 0 auto;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      background: var(--bg-dark);
    }
    .carousel-img {
      width: 800px;
      height: auto;
      display: block;
      cursor: zoom-in;
      transition: opacity 0.15s;
    }
    .carousel-img:hover { opacity: 0.88; }
    .seedarr-indicators { bottom: 10px; }
    .seedarr-indicators li {
      background: var(--text-dim);
      border: none;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin: 0 4px;
    }
    .seedarr-indicators li.active { background: var(--accent); }
    .seedarr-control {
      background: none !important;
      width: 44px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
    }
    .seedarr-carousel:hover .seedarr-control { opacity: 1; pointer-events: auto; }
    .seedarr-control i {
      font-size: 18px;
      color: var(--accent);
      text-shadow: 0 0 8px rgba(0,0,0,0.8);
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
    }
    .left.seedarr-control i  { left: 12px; }
    .right.seedarr-control i { right: 12px; }
    .carousel-hint {
      text-align: center;
      margin-top: 12px;
      font-size: 12px;
      color: var(--text-dim);
    }
    .carousel-hint i { margin-right: 5px; color: var(--accent); }


    /* ─── hljs override ─── */
    .hljs { background: transparent !important; }
  </style>
</head>
<body data-spy="scroll" data-target=".header-navbar" data-offset="70">

<!-- ═══════════════════════════════ NAVBAR ═══════════════════════════════ -->
<nav class="navbar navbar-inverse navbar-fixed-top header-navbar" role="navigation">
  <div class="container">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-ex1-collapse">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a href="#hero" class="navbar-brand">
        <img class="brand-icon" src="img/favicon.svg" alt="">
        <img class="brand-text" src="img/seedarr-text.svg" alt="Seedarr">
      </a>
    </div>
    <div class="collapse navbar-collapse navbar-ex1-collapse">
      <ul class="nav navbar-nav navbar-right">
        <li><a href="#hero"><i class="fas fa-home"></i> Home</a></li>
        <li><a href="#screenshots"><i class="fas fa-images"></i> Screenshots</a></li>
        <li><a href="#features"><i class="fas fa-star"></i> Features</a></li>
        <li><a href="#download"><i class="fas fa-download"></i> Download</a></li>
        <li><a href="https://wiki.servarr.com/" target="_blank" rel="noopener"><i class="fas fa-question-circle"></i> Support</a></li>
        <li><a href="https://github.com/dmzoneill/Seedarr" target="_blank" rel="noopener"><i class="fab fa-github-alt"></i> GitHub</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- ═══════════════════════════════ HERO ═══════════════════════════════ -->
<section id="hero">
  <div class="container text-center">

    <img class="hero-logo" src="img/seedarr-skull.svg" alt="Seedarr">
    <img class="hero-wordmark" src="img/seedarr-text.svg" alt="Seedarr">
    <p class="hero-tagline">The <em>*arr</em> approach to BitTorrent seeding &mdash; maintain your ratio, automatically.</p>

    <div class="hero-pills">
      <span class="hero-pill"><i class="fas fa-tachometer-alt"></i> Real-time Dashboard</span>
      <span class="hero-pill"><i class="fas fa-link"></i> Sonarr &amp; Radarr Integration</span>
      <span class="hero-pill"><i class="fas fa-shield-alt"></i> MSE/PE Encryption</span>
      <span class="hero-pill"><i class="fas fa-network-wired"></i> DHT + PEX</span>
      <span class="hero-pill"><i class="fab fa-docker"></i> Docker Ready</span>
    </div>

    <div class="hero-cta">
      <a href="#download" class="btn btn-seedarr"><i class="fas fa-download"></i> Download</a>
      <a href="https://github.com/dmzoneill/Seedarr" target="_blank" rel="noopener" class="btn btn-seedarr-outline"><i class="fab fa-github"></i> View on GitHub</a>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════ STATS ═══════════════════════════════ -->
<section id="stats">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-value">.NET 10</div>
        <div class="stat-label">Runtime</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">React 19</div>
        <div class="stat-label">Frontend</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">9898</div>
        <div class="stat-label">Default Port</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">10+</div>
        <div class="stat-label">BEP Extensions</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">3</div>
        <div class="stat-label">Client Profiles</div>
      </div>
      <div class="stat-item">
        <div class="stat-value" id="latest-version">...</div>
        <div class="stat-label">Latest Version</div>
      </div>
    </div>
  </div>
</section>

